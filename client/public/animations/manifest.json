{
  "$comment": "Mixamo animation mapping. Paths are relative to client/public/animations/. String values load one clip; arrays load variations that are picked at random (seamless variety). rootCorrection rotates the whole clip around Y in degrees if the character faces the wrong way.",
  "base": { "file": "animations_from_mixmo/Idle.fbx", "rootCorrection": 0 },
  "idleAlts": [],
  "talking": [
    { "file": "animations_from_mixmo/Talking.fbx", "rootCorrection": 0 },
    { "file": "animations_from_mixmo/Talking(1).fbx", "rootCorrection": 0 }
  ],
  "gestures": {
    "thinking": [
      { "file": "animations_from_mixmo/Thinking.fbx", "rootCorrection": 0 },
      { "file": "animations_from_mixmo/thoughtful head shake.fbx", "rootCorrection": 0 }
    ],
    "wave": { "file": "animations_from_mixmo/happy hand gesture.fbx", "rootCorrection": 0 },
    "nod": [
      { "file": "animations_from_mixmo/head nod yes.fbx", "rootCorrection": 0 },
      { "file": "animations_from_mixmo/acknowledging.fbx", "rootCorrection": 0 },
      { "file": "animations_from_mixmo/lengthy head nod.fbx", "rootCorrection": 0 },
      { "file": "animations_from_mixmo/hard head nod.fbx", "rootCorrection": 0 }
    ],
    "shake": [
      { "file": "animations_from_mixmo/shaking head no.fbx", "rootCorrection": 0 },
      { "file": "animations_from_mixmo/annoyed head shake.fbx", "rootCorrection": 0 }
    ],
    "shrug": [
      { "file": "animations_from_mixmo/dismissing gesture.fbx", "rootCorrection": 0 },
      { "file": "animations_from_mixmo/being cocky.fbx", "rootCorrection": 0 }
    ],
    "sad": { "file": "animations_from_mixmo/relieved sigh.fbx", "rootCorrection": 0 },
    "angry": { "file": "animations_from_mixmo/angry gesture.fbx", "rootCorrection": 0 },
    "lookaway": { "file": "animations_from_mixmo/look away gesture.fbx", "rootCorrection": 0 }
  }
}
